# Docker Configuration
PORT=8000
FLASK_ENV=production

# Azure SSO Authentication
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_TENANT_ID=your-tenant-id
AZURE_REDIRECT_URI=http://localhost:8000/auth/callback

# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=your-azure-openai-endpoint
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_DEPLOYMENT=gpt-4
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Flask Session Configuration
FLASK_SECRET_KEY=your-secret-key-here

# Security Configuration
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com
RATE_LIMIT=100
FORCE_HTTPS=true
TRUSTED_PROXIES=1

# SSL Configuration
USE_LETSENCRYPT=true
LETSENCRYPT_DOMAINS=yourdomain.com,www.yourdomain.com
LETSENCRYPT_EMAIL=your-email@domain.com
LETSENCRYPT_STAGING=false  # Set to true for testing
SSL_CERT_PATH=/certs/cert.pem  # Used if USE_LETSENCRYPT=false
SSL_KEY_PATH=/certs/key.pem    # Used if USE_LETSENCRYPT=false
SSL_KEY_PASSWORD=optional-key-password

# ChromaDB Configuration
CHROMA_SERVER_AUTH_CREDENTIALS={"username": "admin", "password": "change-me-in-production"}

# API Security Configuration
API_SIGNING_SECRET=your-signing-secret-here  # Use a strong random value
API_MAX_REQUEST_AGE=300  # Maximum age of signed requests in seconds

# Database Configuration
POSTGRES_USER=vanna
POSTGRES_PASSWORD=change-me-in-production  # Use a strong password
POSTGRES_DB=vanna 