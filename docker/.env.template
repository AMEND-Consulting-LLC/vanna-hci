# Vanna AI Environment Configuration Template
# Copy this file to .env and modify the values as needed

# Core Settings
#-------------
# Enable debug mode (true/false)
VANNA_DEBUG=false

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
VANNA_LOG_LEVEL=INFO

# API Settings
#------------
# Host to bind the API server to
VANNA_API_HOST=0.0.0.0

# Port for the API server
VANNA_API_PORT=8000

# API key for authentication (required)
VANNA_API_KEY=

# Database Settings
#-----------------
# PostgreSQL host
VANNA_DB_HOST=localhost

# PostgreSQL port
VANNA_DB_PORT=5432

# PostgreSQL database name
VANNA_DB_NAME=vanna

# PostgreSQL user (required)
VANNA_DB_USER=

# PostgreSQL password (required)
VANNA_DB_PASSWORD=

# Vector Store Settings
#--------------------
# Type of vector store to use (chromadb, pinecone, weaviate, qdrant, milvus)
VANNA_VECTOR_STORE_TYPE=chromadb

# URL for the vector store service (if applicable)
VANNA_VECTOR_STORE_URL=

# Vector store API key (if applicable)
VANNA_VECTOR_STORE_API_KEY=

# Resource Limits
#---------------
# Maximum memory usage in MB (optional)
VANNA_MAX_MEMORY=4096

# Maximum CPU usage (optional)
VANNA_MAX_CPU=2

# Security Settings
#-----------------
# Enable SSL/TLS (true/false)
VANNA_ENABLE_SSL=false

# Path to SSL certificate (if SSL enabled)
VANNA_SSL_CERT=

# Path to SSL key (if SSL enabled)
VANNA_SSL_KEY= 